rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCustomer() {
      return signedIn() && request.auth.token.role == 'customer';
    }

    function isWorker() {
      return signedIn() && request.auth.token.role == 'worker';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function ownsCustomer(customerId) {
      return signedIn() && request.auth.uid == customerId;
    }

    function ownsWorker(workerId) {
      return signedIn() && request.auth.uid == workerId;
    }

    function booking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function isBookingCustomer(bookingId) {
      return isCustomer()
        && booking(bookingId).data.customerId == request.auth.uid;
    }

    function isAssignedBookingWorker(bookingId) {
      return isWorker()
        && booking(bookingId).data.workerId == request.auth.uid;
    }

    function isBookingParticipant(bookingId) {
      return isBookingCustomer(bookingId)
        || isAssignedBookingWorker(bookingId)
        || isAdmin();
    }

    function isActiveTrackingStatus(status) {
      return status in ['enRoute', 'arrived', 'inService', 'awaitingCompletion'];
    }

    function validProfile(customerId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'email', 'avatarBase64', 'avatarUrl',
          'avatarPublicId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'phone', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == customerId
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && (request.resource.data.email == null
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 254))
        && (!request.resource.data.keys().hasAny(['avatarUrl'])
          || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.matches(
              '^https://res.cloudinary.com/.*')
            && request.resource.data.avatarUrl.size() <= 2048))
        && (!request.resource.data.keys().hasAny(['avatarBase64'])
          || (request.resource.data.avatarBase64 is string
            && request.resource.data.avatarBase64.size() <= 700000))
        && (!request.resource.data.keys().hasAny(['avatarPublicId'])
          || (request.resource.data.avatarPublicId is string
            && request.resource.data.avatarPublicId.size() <= 500))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /customers/{customerId} {
      allow get: if ownsCustomer(customerId) || isAdmin();
      allow list: if false;
      allow create: if ownsCustomer(customerId)
        && validProfile(customerId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsCustomer(customerId)
        && validProfile(customerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'avatarBase64', 'avatarUrl', 'avatarPublicId',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validAddress() {
      return request.resource.data.keys().hasOnly([
          'customerId', 'label', 'formattedAddress', 'latitude', 'longitude',
          'landmark', 'isDefault', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerId', 'label', 'formattedAddress', 'latitude', 'longitude',
          'landmark', 'isDefault', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 50
        && request.resource.data.formattedAddress is string
        && request.resource.data.formattedAddress.size() > 0
        && request.resource.data.formattedAddress.size() <= 500
        && request.resource.data.landmark is string
        && request.resource.data.landmark.size() <= 200
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.isDefault is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /addresses/{addressId} {
      allow create: if signedIn() && validAddress()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get, list: if signedIn()
        && resource.data.customerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && validAddress()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'label', 'formattedAddress', 'latitude', 'longitude', 'landmark',
          'isDefault', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && resource.data.customerId == request.auth.uid;
    }

    // Public worker documents must never contain KYC, bank, or government-ID data.
    function validWorkerProfile(workerId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'phone', 'fullName', 'email', 'avatarUrl', 'status',
          'online', 'acceptingJobs', 'serviceIds', 'experienceYears',
          'ratingAverage', 'ratingCount', 'completedJobs', 'currentBookingId',
          'documentsDeferred', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'phone', 'fullName', 'email', 'status', 'online',
          'acceptingJobs', 'serviceIds', 'experienceYears', 'ratingAverage',
          'ratingCount', 'completedJobs', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == workerId
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && (request.resource.data.email == null
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 254))
        && request.resource.data.serviceIds is list
        && request.resource.data.serviceIds.size() > 0
        && request.resource.data.serviceIds.size() <= 20
        && request.resource.data.experienceYears is int
        && request.resource.data.experienceYears >= 0
        && request.resource.data.experienceYears <= 70
        && request.resource.data.online == false
        && request.resource.data.acceptingJobs == false
        && request.resource.data.ratingAverage == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.completedJobs == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /workers/{workerId} {
      // Own-profile access intentionally works before a role claim is provisioned.
      allow get: if ownsWorker(workerId) || isAdmin();
      allow list: if false;
      allow create: if ownsWorker(workerId)
        && validWorkerProfile(workerId)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsWorker(workerId)
        && validWorkerProfile(workerId)
        && resource.data.status in ['draft', 'rejected']
        && request.resource.data.status in ['draft', 'pendingVerification']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'email', 'avatarUrl', 'serviceIds', 'experienceYears',
          'status', 'documentsDeferred', 'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /workerPrivate/{workerId} {
      allow get: if (isWorker() && ownsWorker(workerId)) || isAdmin();
      allow list, create, update, delete: if false;
    }

    match /services/{serviceId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow get: if isAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid)
        || (isWorker() && resource.data.workerId == request.auth.uid);
      // Queries are permitted only when every returned document satisfies the
      // participant expression above. Eligible unassigned jobs use a callable.
      allow list: if isAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid)
        || (isWorker() && resource.data.workerId == request.auth.uid);
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow get, list: if isBookingParticipant(bookingId);
        allow create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if isBookingParticipant(bookingId);
        allow create: if isBookingParticipant(bookingId)
          && request.resource.data.keys().hasAll([
            'senderId', 'senderRole', 'type', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'type', 'text', 'imageUrl',
            'createdAt', 'readAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == request.auth.token.role
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.createdAt == request.time
          && (request.resource.data.type != 'text'
            || (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000))
          && (request.resource.data.type != 'image'
            || (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.matches(
                '^https://res.cloudinary.com/.*')
              && request.resource.data.imageUrl.size() <= 2048));
        allow update: if isBookingParticipant(bookingId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    match /workerLocations/{workerId} {
      allow get: if (isWorker() && ownsWorker(workerId))
        || isAdmin()
        || (isCustomer()
          && resource.data.workerId == workerId
          && resource.data.activeBookingId is string
          && booking(resource.data.activeBookingId).data.customerId
            == request.auth.uid
          && booking(resource.data.activeBookingId).data.workerId == workerId
          && isActiveTrackingStatus(
            booking(resource.data.activeBookingId).data.status));
      allow list, create, update, delete: if false;
    }

    function validDevice(ownerId) {
      return request.resource.data.keys().hasAll([
          'ownerId', 'token', 'platform', 'enabled', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId', 'token', 'platform', 'enabled', 'updatedAt'
        ])
        && request.resource.data.ownerId == ownerId
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;
    }

    match /customerDevices/{tokenId} {
      allow get: if isCustomer()
        && resource.data.ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isCustomer() && validDevice(request.auth.uid);
      allow update: if isCustomer()
        && resource.data.ownerId == request.auth.uid
        && validDevice(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['token', 'enabled', 'updatedAt']);
      allow delete: if isCustomer()
        && resource.data.ownerId == request.auth.uid;
    }

    match /workerDevices/{tokenId} {
      allow get: if isWorker()
        && resource.data.ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isWorker() && validDevice(request.auth.uid);
      allow update: if isWorker()
        && resource.data.ownerId == request.auth.uid
        && validDevice(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['token', 'enabled', 'updatedAt']);
      allow delete: if isWorker()
        && resource.data.ownerId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
    }

    match /reviews/{bookingId} {
      allow get: if isAdmin()
        || (isCustomer() && resource.data.customerId == request.auth.uid)
        || (isWorker() && resource.data.workerId == request.auth.uid);
      allow list: if isAdmin()
        || (isWorker() && resource.data.workerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /workerEarnings/{entryId} {
      allow get, list: if isAdmin()
        || (isWorker() && resource.data.workerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /workerPayouts/{payoutId} {
      allow get, list: if isAdmin()
        || (isWorker() && resource.data.workerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    function validSupportTicket() {
      return request.resource.data.keys().hasAll([
          'ownerId', 'ownerRole', 'category', 'subject', 'description',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerRole', 'category', 'subject', 'description',
          'bookingId', 'mediaIds', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerRole == request.auth.token.role
        && request.resource.data.category in [
          'booking', 'customer', 'payment', 'payout', 'accountKyc',
          'technical', 'other'
        ]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /supportTickets/{ticketId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if (isCustomer() || isWorker()) && validSupportTicket();
      allow update, delete: if false;
    }

    // Metadata for ordinary images hosted by Cloudinary. KYC is excluded.
    match /media/{mediaId} {
      allow get, list, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'ownerId', 'imageUrl', 'publicId', 'provider', 'kind',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId', 'imageUrl', 'publicId', 'provider', 'kind', 'bookingId',
          'messageId', 'reviewId', 'ticketId', 'contentType', 'size',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.provider == 'cloudinary'
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches(
          '^https://res.cloudinary.com/.*')
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.publicId is string
        && request.resource.data.publicId.size() <= 500
        && request.resource.data.kind in [
          'avatar', 'worker_avatar', 'booking', 'booking_before',
          'booking_after', 'chat', 'review', 'support'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'imageUrl', 'bookingId', 'messageId', 'reviewId', 'ticketId',
          'contentType', 'size', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
